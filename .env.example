# ---------------------------------------------------------------------------
# Only these two are required.
# ---------------------------------------------------------------------------

# Neon POOLED connection string (the host with "-pooler" in it).
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# From elevenlabs.io. Server-side only; it never reaches the browser.
ELEVENLABS_API_KEY=sk_...

# ---------------------------------------------------------------------------
# Everything below is optional and has a working default.
# ---------------------------------------------------------------------------

# Change the sign-in password. Without this, the password built into the repo
# is used. Either form works; APP_PASSWORD wins if both are set.
# APP_PASSWORD=some new password
# APP_PASSWORD_HASH=$2b$12$...        # npm run hash-password -- 'the password'

# Where audio files are stored. On Railway the mounted volume is detected
# automatically (RAILWAY_VOLUME_MOUNT_PATH), so leave this unset there.
# AUDIO_DIR=/data/audio

# Signing key for the session cookie. Derived from DATABASE_URL when unset,
# which keeps sessions alive across deploys. Set it to sign everyone out.
# SESSION_SECRET=48-random-bytes-in-hex

# MAX_UPLOAD_MB=200
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe   # only if ffmpeg is not on PATH
